{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ryzean84/Global-Rights-and-Law-Atlas/blob/main/schemas/oversight-record.v0.3.schema.json",
  "title": "Atlas oversight and accountability record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "record_type",
    "title",
    "jurisdiction_id",
    "lead_institution_ids",
    "related_institution_ids",
    "status",
    "status_as_of",
    "source_ids",
    "source_urls",
    "evidence_grade",
    "summary",
    "limitations",
    "last_checked"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "id": {
      "type": "string",
      "pattern": "^oversight:[A-Za-z0-9._:-]+$"
    },
    "record_type": {
      "enum": [
        "audit_report",
        "rulemaking",
        "enforcement_action",
        "investigation",
        "implementation_deadline",
        "public_response"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction_id": {
      "type": "string",
      "minLength": 1
    },
    "lead_institution_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "related_institution_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "status_as_of": {
      "type": "string",
      "format": "date"
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "source_urls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "evidence_grade": {
      "enum": [
        "primary_source",
        "primary_and_secondary",
        "secondary_reported",
        "unverified_lead"
      ]
    },
    "publication_period": {
      "type": "string",
      "pattern": "^\\d{4}(-\\d{2})?$"
    },
    "tracking_number": {
      "type": "string"
    },
    "rule_citation": {
      "type": "string"
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "event",
          "status",
          "source_urls"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "event": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "source_urls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    },
    "last_checked": {
      "type": "string",
      "format": "date"
    }
  }
}
