{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ryzean84/Global-Rights-and-Law-Atlas/blob/main/schemas/site-catalog.v0.1.schema.json",
  "title": "Global Rights and Law Atlas site catalog",
  "description": "A physical site record linking a geographic anchor to institutions, jurisdictions, official information, and site-specific rule collections.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "site_id",
    "anchor_id",
    "name",
    "operator_or_authority",
    "jurisdiction_ids",
    "last_verified",
    "verification_state"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "site_id": {
      "type": "string",
      "pattern": "^site:[A-Za-z0-9._:-]+$"
    },
    "anchor_id": {
      "type": "string",
      "pattern": "^anchor:[A-Za-z0-9._:-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "operator_or_authority": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "institution_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "official_information_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/information_source"
      }
    },
    "rule_collections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule_collection"
      }
    },
    "visitor_rule_topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "public_access_topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "public_service_topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "institutional_functions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_public_authorities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/related_authority"
      }
    },
    "last_verified": {
      "type": "string",
      "format": "date"
    },
    "verification_state": {
      "enum": [
        "draft",
        "source_checked",
        "status_checked",
        "official_information_sources_checked",
        "reviewed"
      ]
    },
    "notes": {
      "type": "string"
    },
    "scope_warning": {
      "type": "string"
    }
  },
  "anyOf": [
    {
      "required": [
        "official_information_sources"
      ]
    },
    {
      "required": [
        "rule_collections"
      ]
    }
  ],
  "$defs": {
    "information_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "scope"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "related_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "scope",
        "url"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "rule_collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "rule_type",
        "authority",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "rule_type": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "official_index_url": {
          "type": "string",
          "format": "uri"
        },
        "official_url": {
          "type": "string",
          "format": "uri"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "last_verified": {
          "type": "string",
          "format": "date"
        },
        "revision_label": {
          "type": "string"
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "part",
              "topic"
            ],
            "properties": {
              "part": {
                "type": "string"
              },
              "topic": {
                "type": "string"
              }
            }
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "official_index_url"
          ]
        },
        {
          "required": [
            "official_url"
          ]
        }
      ]
    }
  }
}
