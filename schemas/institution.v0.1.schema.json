{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ryzean84/Global-Rights-and-Law-Atlas/blob/main/schemas/institution.v0.1.schema.json",
  "title": "Global Rights and Law Atlas institution record",
  "description": "A government body or civic institution associated with one or more legal jurisdictions and, where verified, one or more physical sites.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "institution_type",
    "jurisdiction_ids",
    "site_ids",
    "source_urls",
    "last_verified",
    "verification_state"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^institution:[A-Za-z0-9._:-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "institution_type": {
      "enum": [
        "legislature",
        "legislative_chamber",
        "legislative_body",
        "executive_office",
        "state_agency",
        "court",
        "municipal_government",
        "election_authority",
        "public_records_office",
        "tribal_government",
        "other"
      ]
    },
    "jurisdiction_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "site_ids": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "source_urls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "last_verified": {
      "type": "string",
      "format": "date"
    },
    "verification_state": {
      "enum": [
        "draft",
        "source_checked",
        "reviewed"
      ]
    },
    "notes": {
      "type": "string"
    }
  }
}
